# Dependencies
node_modules/

# Build output
dist/
build/
.vite/
coverage/
*.tsbuildinfo

# Environment (keep the example committed)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Prisma
backend/prisma/*.db
backend/prisma/*.db-journal

# Editor / OS
.DS_Store
Thumbs.db
.idea/
