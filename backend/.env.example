# Copy to .env and adjust
# PostgreSQL connection string for the Project Hub database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/projecthub"
BACKEND_PORT=4000
CORS_ORIGIN="http://localhost:5173"

# --- Phase 9: AI provider (optional) ---------------------------------------
# Project Hub works fully offline without any of these. They only affect the
# AI Workspace, which sends prompts to the configured provider.
#
# API key: the secret. NEVER commit a real key - .env is gitignored on purpose.
# NEVER put a key in PROJECT.md, STATUS.md, a prompt, or any database record.
# The key is read server-side only and is never returned to the frontend.
AI_PROVIDER_API_KEY=

# Optional defaults. Anything here can be overridden from Settings -> AI
# Provider (stored server-side in app_settings), except AI_BASE_URL which is
# environment-only so a client can never point the backend at an arbitrary URL.
#   AI_PROVIDER       registered provider id (default: openai)
#   AI_MODEL          default model name (provider default when empty)
#   AI_ENABLED        true/false (default: true)
#   AI_TIMEOUT_MS     request timeout, 1000-600000 (default: 60000)
#   AI_BASE_URL       endpoint root; the OpenAI-compatible default is
#                     https://api.openai.com/v1 - point it at OpenRouter,
#                     LM Studio, Ollama's /v1, etc. if you use those
#   AI_MAX_RESPONSE_CHARS  cap on a stored/displayed response (default: 200000)
AI_PROVIDER=
AI_MODEL=
AI_ENABLED=
AI_TIMEOUT_MS=
AI_BASE_URL=
AI_MAX_RESPONSE_CHARS=